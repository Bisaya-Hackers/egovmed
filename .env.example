# ─────────────────────────────────────────────────────────────
# eGovMed — environment template.
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- eGovPH SSO (OAuth / OIDC) ---
EGOV_SSO_CLIENT_ID=
EGOV_SSO_CLIENT_SECRET=
EGOV_SSO_ISSUER_URL=
EGOV_SSO_REDIRECT_URI=http://localhost:3000/auth/callback

# --- National ID eVerify (PhilSys) ---
EVERIFY_API_KEY=
EVERIFY_BASE_URL=

# --- Face Liveness ---
FACE_LIVENESS_API_KEY=
FACE_LIVENESS_BASE_URL=

# --- eGovAI (triage / translation / document intelligence) ---
EGOVAI_API_KEY=
EGOVAI_BASE_URL=

# --- eMessage (SMS / email / in-app) ---
EMESSAGE_API_KEY=
EMESSAGE_BASE_URL=
EMESSAGE_SENDER_ID=

# --- eGovChain (Hyperledger Besu, JSON-RPC) ---
# Anchors only hashes/pointers — never raw PHI.
EGOVCHAIN_RPC_URL=
EGOVCHAIN_CHAIN_ID=
EGOVCHAIN_ANCHOR_CONTRACT_ADDRESS=
EGOVCHAIN_SIGNER_PRIVATE_KEY=

# --- eGovPay ---
EGOVPAY_MERCHANT_ID=
EGOVPAY_API_KEY=
EGOVPAY_BASE_URL=

# --- eReport ---
EREPORT_API_KEY=
EREPORT_BASE_URL=

# --- Database ---
DATABASE_URL=

# --- Session / crypto ---
SESSION_SECRET=
RECORD_HASH_SALT=
