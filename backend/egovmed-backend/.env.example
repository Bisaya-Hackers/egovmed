# ─────────────────────────────────────────────────────────────
# eGovMed backend — environment configuration
# Copy to .env for local dev. Set the same keys in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000                 # frontend origin (CORS + SSO redirect target)
API_PUBLIC_URL=http://localhost:4000          # this backend's public URL (used to build SSO callback)

# Security (GENERATE YOUR OWN — see README)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL=86400                             # session lifetime in seconds
PHI_ENCRYPTION_KEY=change-me-32-byte-hex      # 64 hex chars = 32 bytes, for AES-256-GCM

# Persistence.  memory = in-process (local only); kv = Upstash Redis (recommended on Vercel)
STORE_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global integration switch. Each integration can override with its own *_MODE.
#   live = call the real eGov API   |   mock = return realistic fake data (demo/offline)
INTEGRATION_MODE=mock

# 1) eGovPH  (SSO / auth) ─ exchange-code flow (POST {BASE}/api/token → /api/partner/sso_authentication)
EGOVPH_MODE=
EGOVPH_BASE_URL=https://oauth.e.gov.ph
EGOVPH_PARTNER_CODE=                          # from the eGov admin
EGOVPH_PARTNER_SECRET=                        # from the eGov admin
EGOVPH_SCOPE=SSO_AUTHENTICATION

# 2) eGov AI  (triage engine)
EGOV_AI_MODE=
EGOV_AI_BASE_URL=https://ai.egov.ph
EGOV_AI_API_KEY=
EGOV_AI_MODEL=egov-ai-default

# 3) National ID eVerify  (PhilSys)
EVERIFY_MODE=
EVERIFY_BASE_URL=https://everify.egov.ph
EVERIFY_API_KEY=

# 4) Face Liveness
FACE_LIVENESS_MODE=
FACE_LIVENESS_BASE_URL=https://liveness.egov.ph
FACE_LIVENESS_API_KEY=

# 5) eMessage  (SMS / email / in-app)
EMESSAGE_MODE=
EMESSAGE_BASE_URL=https://message.egov.ph
EMESSAGE_API_KEY=
EMESSAGE_SENDER_ID=eGovMed

# 6) eGovChain  (Hyperledger Besu, JSON-RPC anchoring)
EGOVCHAIN_MODE=
EGOVCHAIN_RPC_URL=
EGOVCHAIN_CHAIN_ID=
EGOVCHAIN_CONTRACT_ADDRESS=
EGOVCHAIN_PRIVATE_KEY=

# 7) eGovPay  (unified payment gateway)
EGOVPAY_MODE=
EGOVPAY_BASE_URL=https://pay.egov.ph
EGOVPAY_MERCHANT_ID=
EGOVPAY_API_KEY=

# 8) eReport  (issue tracking / escalation)
EREPORT_MODE=
EREPORT_BASE_URL=https://report.egov.ph
EREPORT_API_KEY=
EREPORT_ESCALATE_AFTER_HOURS=48
